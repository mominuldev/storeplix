# Phase 4.7: the SPA calls the API same-origin (/api/*, /sanctum/*). In dev the Vite proxy forwards them here.
VITE_API_PROXY_TARGET=http://localhost:8010
# Leave VITE_API_URL unset (same-origin). Only set it for a cross-origin API, which the cookie session does not support.
# Phase 8.4: public API reference linked from Integrations → Developer (hidden when unset).
# VITE_DEVELOPER_DOCS_URL=https://developers.storeplix.com
