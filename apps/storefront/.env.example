# Laravel API base URL (server-side only)
STOREFRONT_API_URL=http://localhost:8000
# Shared secret sent as X-Storefront-Key. Server-only: never prefix with NEXT_PUBLIC_.
STOREFRONT_API_KEY=change-me
# Bearer secret Laravel uses for POST /api/revalidate
REVALIDATE_SECRET=change-me-too
# Seconds before cached store config is refetched (tag-based revalidation is immediate)
STOREFRONT_CONFIG_REVALIDATE=60
# Only set to true behind our own proxy that overwrites X-Forwarded-Host
TRUSTED_PROXY=false
STOREFRONT_LOCAL_PORT=3000
