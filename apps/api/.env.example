APP_NAME="Store Plix"
APP_VERSION=0.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# `php artisan dev` serves with this many workers (QA F-L3; needs --no-reload, which the dev command passes).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# If you run locally on SQLite instead, also set these so the dev workers don't lock each other out (QA F-L3):
# DB_JOURNAL_MODE=wal
# DB_BUSY_TIMEOUT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=storeplix
DB_USERNAME=storeplix
DB_PASSWORD=secret
# Phase 5b row-level security (PHASE-5B-CONTRACT §2.2, §2.9). With TENANCY_RLS=true the app connects as
# storeplix_app (DB_USERNAME), migrates/seeds with --database=pgsql_owner, and platform code uses pgsql_admin.
# Owner/admin default to DB_USERNAME when unset. Roles: infrastructure/docker/postgres/initdb/01-roles.sql.
# DB_USERNAME=storeplix_app
# DB_OWNER_USERNAME=storeplix_owner
# DB_OWNER_PASSWORD=storeplix_owner
# DB_ADMIN_USERNAME=storeplix_admin
# DB_ADMIN_PASSWORD=storeplix_admin
# TENANCY_RLS=true
# THROTTLE_STOREFRONT_PER_IP=300
# THROTTLE_STOREFRONT_PER_HOST=3000
# The per-shopper limit needs the shopper IP that the storefront server forwards in X-Storefront-Client-Ip. The
# storefront only knows it when ITS TRUSTED_PROXY=true (apps/storefront/.env, behind our own proxy that sets
# X-Forwarded-For); otherwise only the per-host limit applies and the API logs `storefront.client_ip_missing`
# (warning, once per host per 5 minutes). TRUSTED_PROXIES (further down) is the API's own proxy list.

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailpit (UI http://localhost:8025). Docker: MAIL_HOST=mailpit
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@storeplix.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Store Plix ---
PLATFORM_DOMAIN=storeplix.test
# Shared secret the storefront (Next.js) sends as X-Storefront-Key. Server-to-server only.
STOREFRONT_API_KEY=change-me-storefront-key
# Sanctum token lifetime in minutes (D3, default 7 days). Expired tokens pruned daily by the scheduler.
SANCTUM_EXPIRATION=10080
# Empty = no cross-origin access (the SPAs are same-origin). Comma-separated origins only if a client needs it.
CORS_ALLOWED_ORIGINS=

# Merchant dashboard base URL (reset-password / staff-invitation links).
MERCHANT_APP_URL=http://localhost:5173

# Media uploads (Phase 2 §1.5). Local: "public" disk served at APP_URL/storage (run `php artisan storage:link`).
# Prod: an R2/S3 disk behind the CDN, with MEDIA_URL=https://cdn.storeplix.com
MEDIA_DISK=public
MEDIA_URL=

# Storefront on-demand revalidation (QA M-1). Same secret in apps/storefront. Empty = no-op.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# SMS (Addendum A): revesms (prod) | log (local: writes the SMS to the log + dev_otp in responses) | fake (tests)
SMS_DRIVER=log
REVESMS_BASE_URL=https://smpp.revesms.com:7790
REVESMS_API_KEY=
REVESMS_SECRET_KEY=
REVESMS_CALLER_ID=

# Phase 4: bulk data (CSV imports/exports). Private disk for uploads and export files (tenant-prefixed).
PRIVATE_DISK=local
# merchant-bulk throttle: imports/exports per tenant per hour (SECURITY T24). Raise locally to re-run e2e.
THROTTLE_MERCHANT_BULK_PER_HOUR=10

# Phase 4.7 cookie sessions (§7.2). Prod: SESSION_DRIVER=redis, SESSION_COOKIE=__Host-sp_session, SESSION_SECURE_COOKIE=true,
# SANCTUM_STATEFUL_DOMAINS=app.storeplix.com,admin.storeplix.com. Never list storefront hosts here.
SESSION_COOKIE=sp_session
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174
# Proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or *). Empty = none.
TRUSTED_PROXIES=

# Phase 5b-4 documents (PHASE-5B §15, ADR 0014). `html` (default) stores the rendered HTML instead of a PDF, for local
# dev and CI without the container; compose / production set `gotenberg`. The worker is `queue:listen --queue=documents`.
DOCUMENTS_DRIVER=html
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
GOTENBERG_TIMEOUT=30

# Phase 5b-2 online payments (PHASE-5B §15). Merchant gateway credentials are encrypted with this dedicated key, never
# APP_KEY: 32 bytes base64 (php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"). Rotation: move the
# old key to INTEGRATION_CREDENTIALS_PREVIOUS_KEYS (comma-separated), set a new one, run `php artisan integrations:rotate-key`.
INTEGRATION_CREDENTIALS_KEY=
INTEGRATION_CREDENTIALS_PREVIOUS_KEYS=
# true = FakeGateway for bKash and SSLCommerz + the /api/v1/dev/fake-gateway page (local/testing/e2e). Refused in production.
PAYMENTS_FAKE=true
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout
# Not published by bKash: live mode can't be enabled until this is set.
BKASH_LIVE_BASE_URL=
SSLCOMMERZ_SANDBOX_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_LIVE_BASE_URL=https://securepay.sslcommerz.com
PAYMENT_HOLD_MINUTES=30
PAYMENT_LINK_DEFAULT_MINUTES=120
# Base for signed payment return URLs and webhook URLs (the tunnel URL during sandbox work).
PUBLIC_API_URL=http://localhost:8000

# Phase 5b-3 couriers (PHASE-5B §15). Merchant courier credentials are encrypted with INTEGRATION_CREDENTIALS_KEY.
# true = FakeCourier for Steadfast, Pathao and RedX (+ couriers:fake-advance) (local/testing/e2e). Refused in production.
COURIERS_FAKE=true
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
PATHAO_SANDBOX_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_LIVE_BASE_URL=https://api-hermes.pathao.com
REDX_SANDBOX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta
REDX_LIVE_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
COURIER_SYNC_MINUTES=15
COURIER_SYNC_BATCH=100
