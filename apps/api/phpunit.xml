<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="MEDIA_DISK" value="public"/>
        <env name="MEDIA_URL" value=""/>
        <env name="MERCHANT_APP_URL" value="http://localhost:5173"/>
        <!-- force: CI sets workflow-level sentinel secrets (for the bundle-leak check); tests use these fixed values. Laravel reads $_SERVER first, so both env and server are forced. -->
        <env name="STOREFRONT_REVALIDATE_URL" value="" force="true"/>
        <server name="STOREFRONT_REVALIDATE_URL" value="" force="true"/>
        <env name="REVALIDATE_SECRET" value="" force="true"/>
        <server name="REVALIDATE_SECRET" value="" force="true"/>
        <env name="SMS_DRIVER" value="fake"/>
        <!-- Phase 6: fake DNS + fake provider (CI never calls Cloudflare or a public DoH resolver). -->
        <env name="DOMAINS_FAKE" value="true"/>
        <env name="DOMAINS_ASK_KEY" value="test-ask-key-0123456789abcdef0123"/>
        <!-- Phase 7: fake platform billing gateway (CI never calls bKash or SSLCommerz). -->
        <env name="BILLING_FAKE" value="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="PLATFORM_DOMAIN" value="storeplix.test"/>
        <env name="STOREFRONT_API_KEY" value="test-storefront-key" force="true"/>
        <server name="STOREFRONT_API_KEY" value="test-storefront-key" force="true"/>
    </php>
</phpunit>
