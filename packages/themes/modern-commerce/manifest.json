{
  "theme": "modern-commerce",
  "name": "Gallery",
  "version": "1.1.0",
  "schema": "schema.v1.json",
  "limits": {
    "maxSections": 30,
    "maxConfigBytes": 65536,
    "maxRichTextBytes": 10240,
    "idPattern": "^[a-z0-9]{8,16}$"
  },
  "sectionDesign": {
    "key": "design",
    "fields": [
      {
        "key": "background",
        "label": "Background",
        "widget": "segmented",
        "options": [
          {
            "value": "default",
            "label": "Page"
          },
          {
            "value": "muted",
            "label": "Soft"
          },
          {
            "value": "brand",
            "label": "Primary"
          },
          {
            "value": "accent",
            "label": "Accent"
          },
          {
            "value": "inverse",
            "label": "Dark"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ]
      },
      {
        "key": "customBackground",
        "label": "Custom colour",
        "widget": "color",
        "showIf": {
          "key": "background",
          "equals": "custom"
        }
      },
      {
        "key": "textTone",
        "label": "Text colour",
        "widget": "segmented",
        "options": [
          {
            "value": "auto",
            "label": "Auto"
          },
          {
            "value": "dark",
            "label": "Dark"
          },
          {
            "value": "light",
            "label": "Light"
          }
        ]
      },
      {
        "key": "paddingTop",
        "label": "Space above",
        "widget": "slider",
        "min": 0,
        "max": 160,
        "step": 8,
        "unit": "px"
      },
      {
        "key": "paddingBottom",
        "label": "Space below",
        "widget": "slider",
        "min": 0,
        "max": 160,
        "step": 8,
        "unit": "px"
      },
      {
        "key": "visibility",
        "label": "Show on",
        "widget": "visibility",
        "options": [
          {
            "value": "desktop",
            "label": "Desktop"
          },
          {
            "value": "tablet",
            "label": "Tablet"
          },
          {
            "value": "phone",
            "label": "Phone"
          }
        ]
      }
    ]
  },
  "globalSettings": [
    {
      "group": "colours",
      "label": "Colours",
      "fields": [
        {
          "key": "primaryColor",
          "label": "Primary",
          "widget": "color",
          "help": "Buttons, links, prices"
        },
        {
          "key": "secondaryColor",
          "label": "Accent",
          "widget": "color",
          "help": "Sale badges, highlights"
        },
        {
          "key": "textColor",
          "label": "Text",
          "widget": "color",
          "help": "Headings and body"
        },
        {
          "key": "backgroundColor",
          "label": "Background",
          "widget": "color",
          "help": "Page background"
        }
      ]
    },
    {
      "group": "fonts",
      "label": "Fonts",
      "fields": [
        {
          "key": "fontPairing",
          "label": "Fonts",
          "widget": "font-pairing",
          "writes": [
            "headingFontFamily",
            "fontFamily"
          ],
          "source": "fonts.json#/pairings"
        }
      ]
    },
    {
      "group": "shape",
      "label": "Corners & buttons",
      "fields": [
        {
          "key": "cornerStyle",
          "label": "Corners & buttons",
          "widget": "segmented",
          "options": [
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "rounded",
              "label": "Rounded"
            },
            {
              "value": "pill",
              "label": "Pill"
            }
          ]
        }
      ]
    },
    {
      "group": "announcement",
      "label": "Announcement bar",
      "locked": true,
      "fields": [
        {
          "key": "announcement.enabled",
          "label": "Show announcement bar",
          "widget": "toggle"
        },
        {
          "key": "announcement.text",
          "label": "Message",
          "widget": "text",
          "maxLength": 120
        },
        {
          "key": "announcement.href",
          "label": "Link",
          "widget": "link",
          "nullable": true
        }
      ]
    },
    {
      "group": "header",
      "label": "Header & menu",
      "locked": true,
      "fields": [
        {
          "key": "header.promoLink",
          "label": "Promo link",
          "widget": "promo-link",
          "nullable": true,
          "labelMaxLength": 30
        }
      ],
      "help": "Menu links come from Online store › Navigation."
    },
    {
      "group": "footer",
      "label": "Footer",
      "locked": true,
      "fields": [
        {
          "key": "footer.tagline",
          "label": "Tagline",
          "widget": "textarea",
          "maxLength": 240,
          "nullable": true
        },
        {
          "key": "footer.showPaymentMethods",
          "label": "Show payment methods",
          "widget": "toggle"
        },
        {
          "key": "footer.paymentMethods",
          "label": "Payment methods",
          "widget": "multi-select",
          "maxItems": 8,
          "options": [
            {
              "value": "cod",
              "label": "Cash on delivery"
            },
            {
              "value": "bkash",
              "label": "bKash"
            },
            {
              "value": "nagad",
              "label": "Nagad"
            },
            {
              "value": "rocket",
              "label": "Rocket"
            },
            {
              "value": "upay",
              "label": "Upay"
            },
            {
              "value": "visa",
              "label": "Visa"
            },
            {
              "value": "mastercard",
              "label": "Mastercard"
            },
            {
              "value": "amex",
              "label": "American Express"
            }
          ]
        }
      ]
    }
  ],
  "hiddenSettings": [
    "buttonStyle",
    "logoOnDarkMediaId",
    "header.sticky",
    "header.showSearch"
  ],
