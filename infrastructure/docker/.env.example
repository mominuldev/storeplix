# Root .env for docker compose (copy to /.env). DEV-ONLY values — never reuse in staging/prod.
# Laravel's own settings live in apps/api/.env; compose overrides DB/REDIS/MAIL hosts for containers.

POSTGRES_DB=storeplix
POSTGRES_USER=storeplix
POSTGRES_PASSWORD=storeplix

# Phase 5b row-level security (PHASE-5B-CONTRACT §2.1–2.2). initdb/01-roles.sql creates these roles on a fresh volume;
# for an existing volume re-run it, or `docker compose down -v`. Change the passwords outside local dev.
STOREPLIX_OWNER_PASSWORD=storeplix_owner   # owns tables; migrations and seeding (--database=pgsql_owner)
STOREPLIX_APP_PASSWORD=storeplix_app       # the API's connection; never BYPASSRLS
STOREPLIX_ADMIN_PASSWORD=storeplix_admin   # withoutTenancy(), console, scheduler
TENANCY_RLS=true

PLATFORM_DOMAIN=storeplix.test

# Shared secret: api <-> storefront server-to-server only. Generate: openssl rand -hex 32
# Never expose to browsers (no NEXT_PUBLIC_ / VITE_ prefix).
STOREFRONT_API_KEY=dev-storefront-key-change-me

# Shared secret api -> storefront /api/revalidate (same value in both). openssl rand -base64 32
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# SMS: `log` writes codes to the API log and enables the dev_otp hint (local only). Prod: revesms + credentials.
SMS_DRIVER=log
REVESMS_API_KEY=
REVESMS_SECRET_KEY=
REVESMS_CALLER_ID=

# Phase 3: dashboard origin(s) allowed to embed the storefront preview (exact origins, comma list).
# Must match the merchant dashboard URL the browser uses (MERCHANT_PORT below).
STOREFRONT_EDITOR_ORIGINS=http://localhost:5173

# Host ports
API_PORT=8000
HTTP_PORT=80
STOREFRONT_PORT=3000
MERCHANT_PORT=5173
ADMIN_PORT=5174
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Phase 4.7 cookie auth (PHASE-4-CONTRACT §7): both default to empty in docker-compose.yml, so the SPAs call
# /api and /sanctum same-origin through the Vite proxy (VITE_API_PROXY_TARGET) and no CORS origin is allowed.
# Prod-like hosts through Nginx: http://app.localhost and http://admin.localhost.
#VITE_API_URL=
#CORS_ALLOWED_ORIGINS=

# Phase 5b-2 payments (PHASE-5B-CONTRACT §15). DEV-ONLY: never reuse these values outside local dev.
# PAYMENTS_FAKE=true serves the fake hosted gateway page (Pay / Fail / Cancel); the API refuses it in production.
PAYMENTS_FAKE=true
# Phase 5b-3: COURIERS_FAKE=true binds FakeCourier for Steadfast/Pathao/RedX (no real courier); refused in production.
COURIERS_FAKE=true
# Encrypts merchant gateway/courier credentials (separate from APP_KEY). Generate: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=base64:97PbbDQ+sQ8MRru928hXvVNBBCs+bsxiMkiVbd3d0pc=
# Base of signed payment return URLs + webhook URLs shown to merchants (sandbox: the https tunnel URL).
PUBLIC_API_URL=http://localhost:8000

# Phase 6 custom domains (PHASE-6-CONTRACT §11). DEV-ONLY: never reuse these values outside local dev.
# DOMAINS_FAKE=true binds the fake DNS resolver + fake Cloudflare for SaaS provider, accepts `*.localhost` custom hosts
# and registers /api/v1/dev/domains/*; the API refuses it in production. Certification against a real Cloudflare zone:
# DOMAINS_FAKE=false + CLOUDFLARE_API_TOKEN + CLOUDFLARE_ZONE_ID (docs/deployment/RUNBOOK.md §9).
DOMAINS_FAKE=true
# Shared key of the internal Caddy `ask` endpoint (32+ random chars outside dev: openssl rand -hex 32). Empty → 401.
DOMAINS_ASK_KEY=dev-domains-ask-key-change-me
#DOMAINS_CNAME_TARGET=customers.storeplix.test
#DOMAINS_FAKE_SSL_POLLS=1
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Phase 7 billing (PHASE-7-CONTRACT §12). DEV-ONLY: never reuse these values outside local dev.
# BILLING_FAKE=true binds the fake platform gateway (hosted page /api/v1/dev/fake-billing-gateway/{payment}) and the
# testing-only POST /api/v1/dev/billing/clock; the API refuses it in production. Certification (§13): BILLING_FAKE=false,
# BILLING_GATEWAY_MODE=sandbox, the platform sandbox credentials below and PUBLIC_API_URL=<https tunnel>.
BILLING_FAKE=true
BILLING_GATEWAY_MODE=sandbox
# Storeplix's OWN gateway accounts (secret manager in production). Empty → that provider is not offered.
BILLING_BKASH_APP_KEY=
BILLING_BKASH_APP_SECRET=
BILLING_BKASH_USERNAME=
BILLING_BKASH_PASSWORD=
BILLING_SSLCOMMERZ_STORE_ID=
BILLING_SSLCOMMERZ_STORE_PASSWD=
#BILLING_VAT_BIN=
#BILLING_OPS_EMAIL=billing-ops@storeplix.test
