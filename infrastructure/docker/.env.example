# Root .env for docker compose (copy to /.env). DEV-ONLY values — never reuse in staging/prod.
# Laravel's own settings live in apps/api/.env; compose overrides DB/REDIS/MAIL hosts for containers.

POSTGRES_DB=storeplix
POSTGRES_USER=storeplix
POSTGRES_PASSWORD=storeplix

PLATFORM_DOMAIN=storeplix.test

# Shared secret: api <-> storefront server-to-server only. Generate: openssl rand -hex 32
# Never expose to browsers (no NEXT_PUBLIC_ / VITE_ prefix).
STOREFRONT_API_KEY=dev-storefront-key-change-me

# Shared secret api -> storefront /api/revalidate (same value in both). openssl rand -base64 32
REVALIDATE_SECRET=dev-revalidate-secret-change-me

# SMS: `log` writes codes to the API log and enables the dev_otp hint (local only). Prod: revesms + credentials.
SMS_DRIVER=log
REVESMS_API_KEY=
REVESMS_SECRET_KEY=
REVESMS_CALLER_ID=

# Phase 3: dashboard origin(s) allowed to embed the storefront preview (exact origins, comma list).
# Must match the merchant dashboard URL the browser uses (MERCHANT_PORT below).
STOREFRONT_EDITOR_ORIGINS=http://localhost:5173

# Host ports
API_PORT=8000
HTTP_PORT=80
STOREFRONT_PORT=3000
MERCHANT_PORT=5173
ADMIN_PORT=5174
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Phase 4.7 cookie auth (PHASE-4-CONTRACT §7): both default to empty in docker-compose.yml, so the SPAs call
# /api and /sanctum same-origin through the Vite proxy (VITE_API_PROXY_TARGET) and no CORS origin is allowed.
# Prod-like hosts through Nginx: http://app.localhost and http://admin.localhost.
#VITE_API_URL=
#CORS_ALLOWED_ORIGINS=
